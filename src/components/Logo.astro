---
// Logo tipográfico provisorio. Cuando tengas los PNG/SVG finales, reemplazalo por un <img>.
interface Props {
  tamano?: 'chico' | 'grande';
}
const { tamano = 'chico' } = Astro.props;
---

<span class:list={['logo', `logo--${tamano}`]} aria-label="Cultura Freestyle">
  <svg class="corona" viewBox="0 0 64 32" aria-hidden="true">
    <path d="M6 26 L12 6 L24 20 L32 4 L40 20 L52 6 L58 26 Z" fill="none" stroke="currentColor" stroke-width="5" stroke-linejoin="round" stroke-linecap="round"></path>
  </svg>
  <span class="cultura" aria-hidden="true">Cultura</span>
  <span class="freestyle" aria-hidden="true">Freestyle</span>
</span>

<style>
  .logo {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    line-height: 0.85;
    font-family: var(--f-marker);
    transform: rotate(-4deg);
    padding-top: 0.35em;
  }
  .corona {
    position: absolute;
    top: -0.05em;
    left: 38%;
    width: 1.3em;
    color: var(--azul);
    transform: rotate(8deg);
  }
  .cultura {
    color: var(--blanco);
    font-size: 1em;
  }
  .freestyle {
    color: var(--azul);
    font-size: 1.15em;
    margin-left: 0.4em;
    text-shadow:
      2px 2px 0 var(--negro),
      0 0 0 var(--negro);
    position: relative;
  }
  .freestyle::after {
    content: '';
    position: absolute;
    left: -0.2em;
    right: 0;
    bottom: -0.12em;
    height: 0.12em;
    border-radius: 1em;
    background: var(--rosa);
    transform: rotate(-2deg);
  }
  .logo--chico {
    font-size: 20px;
  }
  .logo--grande {
    font-size: clamp(44px, 14vw, 88px);
  }
</style>
