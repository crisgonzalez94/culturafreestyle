---
// Logo de Cultura Freestyle.
// - chico: isotipo "CF" + nombre, para la cabecera.
// - grande: insignia completa, para el inicio.
import { Image } from 'astro:assets';
import insignia from '../assets/logo-badge.png';
import isotipo from '../assets/logo-cf.png';

interface Props {
  tamano?: 'chico' | 'grande';
}
const { tamano = 'chico' } = Astro.props;
---

{tamano === 'grande' ? (
  <Image
    class="logo-grande"
    src={insignia}
    alt="Cultura Freestyle"
    widths={[320, 480, 640, 917]}
    sizes="(min-width: 640px) 380px, 80vw"
    loading="eager"
    fetchpriority="high"
  />
) : (
  <span class="logo-chico">
    <Image src={isotipo} alt="" width={40} height={40} densities={[1, 2, 3]} loading="eager" />
    <span class="logo-chico__nombre">Cultura <span>Freestyle</span></span>
  </span>
)}

<style>
  .logo-grande {
    display: block;
    width: min(80vw, 380px);
    height: auto;
    margin-inline: auto;
  }
  .logo-chico {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .logo-chico img {
    width: 40px;
    height: 40px;
  }
  .logo-chico__nombre {
    font-family: var(--f-marker);
    font-size: 18px;
    line-height: 1;
    color: var(--blanco);
  }
  .logo-chico__nombre span {
    color: var(--azul);
  }
</style>
