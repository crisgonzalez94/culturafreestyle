---
import { DISCIPLINAS, nombreTipo } from '../data/disciplinas';
import { lugarCorto, type Ocurrencia } from '../lib/eventos';
import { etiquetaFrecuencia, fechaCorta } from '../lib/fechas';

interface Props {
  o: Ocurrencia;
}
const { o } = Astro.props;
const ev = o.evento;
const acento = DISCIPLINAS[ev.disciplinas[0]].acento;
---

<article
  class="card"
  data-acento={acento}
  data-slug={o.slug}
  data-fecha={o.fecha}
  data-fin={o.fechaFin ?? o.fecha}
  data-disciplinas={ev.disciplinas.join(' ')}
  data-suspendido={ev.estado === 'suspendido' ? '' : undefined}
>
  <a href={`/eventos/${o.slug}`} class="card__link">
    <div class="card__top">
      <span class="card__tipo">{nombreTipo(ev.tipo)}</span>
      {ev.estado === 'a-confirmar' && <span class="card__estado">A confirmar</span>}
      {ev.estado === 'suspendido' && <span class="card__estado card__estado--off">Suspendido</span>}
      {ev.destacado && <span class="card__destacado" aria-label="Destacado">★</span>}
    </div>

    <h3 class="card__titulo">{ev.titulo}</h3>

    <ul class="card__info">
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 7v5l3 2M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z" /></svg>
        <span>
          {ev.hora ?? 'Horario a definir'}
          {o.fechaFin && ` · hasta el ${fechaCorta(o.fechaFin)}`}
          {ev.repite && <span class="card__repite"> · {etiquetaFrecuencia(ev.repite.frecuencia, ev.fecha)}</span>}
        </span>
      </li>
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21zM12 12a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z" /></svg>
        <span>{lugarCorto(ev.lugar)}</span>
      </li>
    </ul>

    <div class="card__tags">
      {ev.disciplinas.map((d) => (
        <span class={`tag tag--${DISCIPLINAS[d].acento}`}>{DISCIPLINAS[d].emoji} {DISCIPLINAS[d].nombre}</span>
      ))}
      {ev.etiquetas.slice(0, 3).map((t) => <span class="tag">#{t}</span>)}
      <span class="tag">{ev.costo}</span>
    </div>
  </a>
</article>

<style>
  .card {
    --acento: var(--azul);
    position: relative;
    background: var(--superficie);
    border: 2px solid #2a2a2a;
    border-radius: var(--radio);
    box-shadow: 4px 4px 0 var(--acento);
    transition: transform 0.12s, box-shadow 0.12s;
  }
  .card[data-acento='pink'] {
    --acento: var(--rosa);
  }
  .card[data-acento='white'] {
    --acento: var(--blanco);
  }
  .card:active {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--acento);
  }
  @media (hover: hover) {
    .card:hover {
      transform: translate(-2px, -2px);
      box-shadow: 6px 6px 0 var(--acento);
    }
  }
  .card[data-suspendido] {
    opacity: 0.55;
  }
  .card[data-suspendido] .card__titulo {
    text-decoration: line-through;
  }

  .card__link {
    display: block;
    padding: 14px 16px 16px;
    color: inherit;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  .card__top {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
  }
  .card__tipo {
    font-family: var(--f-marker);
    color: var(--acento);
    font-size: 15px;
  }
  .card__estado {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 2px 8px;
    border-radius: 6px;
    background: #3a3215;
    color: #ffd76a;
  }
  .card__estado--off {
    background: #3a1520;
    color: #ff8a9f;
  }
  .card__destacado {
    margin-left: auto;
    color: var(--rosa);
    font-size: 18px;
  }
  .card__titulo {
    font-size: 24px;
    margin-bottom: 10px;
  }
  .card__info {
    list-style: none;
    margin: 0 0 12px;
    padding: 0;
    display: grid;
    gap: 4px;
    color: var(--texto-suave);
    font-size: 14.5px;
  }
  .card__info li {
    display: flex;
    gap: 8px;
    align-items: flex-start;
  }
  .card__info svg {
    flex: none;
    width: 18px;
    height: 18px;
    margin-top: 2px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .card__repite {
    color: var(--texto);
  }
  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
</style>
