---
import Base from '../layouts/Base.astro';
import { DISCIPLINAS, nombreTipo } from '../data/disciplinas';
import { lugarCorto, obtenerOcurrencias } from '../lib/eventos';

const ocurrencias = await obtenerOcurrencias();
const datos = ocurrencias.map((o) => ({
  slug: o.slug,
  fecha: o.fecha,
  fin: o.fechaFin ?? o.fecha,
  titulo: o.evento.titulo,
  hora: o.evento.hora ?? '',
  tipo: nombreTipo(o.evento.tipo),
  lugar: lugarCorto(o.evento.lugar),
  acento: DISCIPLINAS[o.evento.disciplinas[0]].acento,
  emojis: o.evento.disciplinas.map((d) => DISCIPLINAS[d].emoji).join(' '),
  suspendido: o.evento.estado === 'suspendido',
}));
---

<Base titulo="Calendario" descripcion="Calendario de rolleadas, salidas, jams y eventos freestyle.">
  <div class="contenedor">
    <div class="cal-cabecera">
      <button class="nav-mes" type="button" id="anterior" aria-label="Mes anterior">‹</button>
      <h1 id="mes" aria-live="polite"></h1>
      <button class="nav-mes" type="button" id="siguiente" aria-label="Mes siguiente">›</button>
    </div>

    <div class="cal" role="grid" aria-labelledby="mes">
      <div class="cal__dows" role="row">
        {['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'].map((d) => <span role="columnheader">{d}</span>)}
      </div>
      <div class="cal__dias" id="dias"></div>
    </div>

    <section class="del-dia">
      <h2 id="titulo-dia"></h2>
      <ul id="lista-dia" class="lista-dia"></ul>
    </section>
  </div>

  <script is:inline type="application/json" id="datos-cal" set:html={JSON.stringify(datos).replace(/</g, '\\u003c')}></script>
</Base>

<script>
  import { MESES_LARGOS, fechaLarga, hoyLocal } from '../lib/fechas';

  type Item = {
    slug: string; fecha: string; fin: string; titulo: string; hora: string; tipo: string;
    lugar: string; acento: string; emojis: string; suspendido: boolean;
  };

  const datos: Item[] = JSON.parse(document.getElementById('datos-cal')!.textContent!);
  const hoy = hoyLocal();
  let [anio, mes] = hoy.split('-').map(Number); // mes 1-12
  let seleccionado = hoy;

  const fmt = (y: number, m: number, d: number) =>
    `${y}-${String(m).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
  const delDia = (f: string) => datos.filter((e) => e.fecha <= f && e.fin >= f && e.fin >= hoy);

  const $dias = document.getElementById('dias')!;
  const $mes = document.getElementById('mes')!;
  const $tituloDia = document.getElementById('titulo-dia')!;
  const $lista = document.getElementById('lista-dia')!;

  const escapar = (t: string) =>
    t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  function pintarMes() {
    $mes.textContent = `${MESES_LARGOS[mes - 1]} ${anio}`;
    const primero = new Date(Date.UTC(anio, mes - 1, 1)).getUTCDay(); // 0 = dom
    const offset = (primero + 6) % 7; // semana empieza el lunes
    const total = new Date(Date.UTC(anio, mes, 0)).getUTCDate();

    let html = '';
    for (let i = 0; i < offset; i++) html += '<span class="vacio" aria-hidden="true"></span>';
    for (let d = 1; d <= total; d++) {
      const f = fmt(anio, mes, d);
      const evs = delDia(f);
      const puntos = evs
        .slice(0, 3)
        .map((e) => `<i class="punto punto--${e.acento}"></i>`)
        .join('');
      html += `<button type="button" class="dia${f === hoy ? ' es-hoy' : ''}${f < hoy ? ' pasado' : ''}"
        data-fecha="${f}" aria-pressed="${f === seleccionado}"
        aria-label="${fechaLarga(f)}${evs.length ? `, ${evs.length} evento${evs.length > 1 ? 's' : ''}` : ''}">
        <span>${d}</span><span class="puntos">${puntos}${evs.length > 3 ? '<b>+</b>' : ''}</span>
      </button>`;
    }
    $dias.innerHTML = html;
  }

  function pintarDia() {
    const evs = delDia(seleccionado);
    $tituloDia.textContent = seleccionado === hoy ? `Hoy · ${fechaLarga(seleccionado)}` : fechaLarga(seleccionado);
    $lista.innerHTML = evs.length
      ? evs
          .map(
            (e) => `<li class="item item--${e.acento}${e.suspendido ? ' item--off' : ''}">
              <a href="/eventos/${e.slug}">
                <span class="item__hora">${escapar(e.hora || '—')}</span>
                <span class="item__cuerpo">
                  <span class="item__tipo">${escapar(e.tipo)} ${e.emojis}</span>
                  <strong>${escapar(e.titulo)}</strong>
                  <span class="item__lugar">${escapar(e.lugar)}</span>
                </span>
              </a>
            </li>`,
          )
          .join('')
      : '<li class="sin-eventos">No hay nada cargado este día.</li>';
  }

  $dias.addEventListener('click', (ev) => {
    const btn = (ev.target as HTMLElement).closest<HTMLButtonElement>('.dia');
    if (!btn) return;
    seleccionado = btn.dataset.fecha!;
    $dias.querySelectorAll('.dia').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    pintarDia();
  });

  const moverMes = (delta: number) => {
    mes += delta;
    if (mes < 1) [mes, anio] = [12, anio - 1];
    if (mes > 12) [mes, anio] = [1, anio + 1];
    pintarMes();
  };
  document.getElementById('anterior')!.addEventListener('click', () => moverMes(-1));
  document.getElementById('siguiente')!.addEventListener('click', () => moverMes(1));

  pintarMes();
  pintarDia();
</script>

<style>
  .cal-cabecera {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-block: 20px 14px;
  }
  .cal-cabecera h1 {
    font-size: 34px;
    text-align: center;
  }
  .nav-mes {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    border: 2px solid var(--borde);
    background: var(--superficie);
    color: var(--texto);
    font-size: 26px;
    line-height: 1;
    cursor: pointer;
  }

  .cal {
    max-width: 640px;
    margin-inline: auto;
  }
  .cal__dows,
  .cal :global(.cal__dias) {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
  }
  .cal__dows span {
    text-align: center;
    font-size: 12px;
    font-weight: 700;
    color: var(--texto-suave);
    text-transform: uppercase;
    padding-bottom: 6px;
  }
  .cal :global(.dia) {
    aspect-ratio: 1 / 1.05;
    min-height: 44px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    border-radius: 10px;
    border: 2px solid transparent;
    background: var(--superficie);
    color: var(--texto);
    font: 700 16px/1 var(--f-texto);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .cal :global(.dia.pasado) {
    color: #555;
  }
  .cal :global(.dia.es-hoy) {
    border-color: var(--rosa);
  }
  .cal :global(.dia[aria-pressed='true']) {
    background: var(--azul);
    color: var(--negro);
  }
  .cal :global(.puntos) {
    display: flex;
    gap: 3px;
    height: 7px;
    align-items: center;
  }
  .cal :global(.punto) {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--azul);
  }
  .cal :global(.punto--pink) {
    background: var(--rosa);
  }
  .cal :global(.punto--white) {
    background: var(--blanco);
  }
  .cal :global(.dia[aria-pressed='true'] .punto) {
    background: var(--negro);
  }
  .cal :global(.puntos b) {
    font-size: 10px;
  }

  .del-dia {
    max-width: 640px;
    margin: 24px auto 0;
  }
  .del-dia h2 {
    font-size: 22px;
    margin-bottom: 12px;
  }
  .del-dia h2::first-letter {
    text-transform: uppercase;
  }
  .lista-dia {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
  }
  .lista-dia :global(.item a) {
    display: flex;
    gap: 14px;
    padding: 12px 14px;
    background: var(--superficie);
    border-radius: 12px;
    border-left: 5px solid var(--azul);
    color: inherit;
    text-decoration: none;
  }
  .lista-dia :global(.item--pink a) {
    border-left-color: var(--rosa);
  }
  .lista-dia :global(.item--white a) {
    border-left-color: var(--blanco);
  }
  .lista-dia :global(.item--off) {
    opacity: 0.5;
  }
  .lista-dia :global(.item__hora) {
    font-family: var(--f-display);
    font-size: 20px;
    min-width: 52px;
  }
  .lista-dia :global(.item__cuerpo) {
    display: grid;
    gap: 2px;
  }
  .lista-dia :global(.item__tipo) {
    font-family: var(--f-marker);
    color: var(--azul);
    font-size: 14px;
  }
  .lista-dia :global(.item--pink .item__tipo) {
    color: var(--rosa);
  }
  .lista-dia :global(.item__lugar) {
    color: var(--texto-suave);
    font-size: 14px;
  }
  .lista-dia :global(.sin-eventos) {
    color: var(--texto-suave);
    padding: 16px 0;
  }
</style>
