---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { DISCIPLINAS, NIVELES, nombreTipo } from '../../data/disciplinas';
import { diasEntre, fechasDe, urlInstagram, urlMapa, urlWhatsapp, type Evento } from '../../lib/eventos';
import { etiquetaFrecuencia, fechaCorta, fechaLarga, hoyLocal, sumarDias } from '../../lib/fechas';

export async function getStaticPaths() {
  const eventos = await getCollection('eventos');
  return eventos.map((evento) => ({ params: { slug: evento.id }, props: { evento } }));
}

const { evento } = Astro.props as { evento: Evento };
const ev = evento.data;
const { Content } = await render(evento);

const acento = DISCIPLINAS[ev.disciplinas[0]].acento;
const proximas = ev.repite ? fechasDe(evento, sumarDias(hoyLocal(), -1)).slice(0, 8) : [];
const duracion = ev.fechaFin ? diasEntre(ev.fecha, ev.fechaFin) : 0;
const horario = [ev.hora, ev.horaFin].filter(Boolean).join(' a ') || 'Horario a definir';
const contacto = ev.contacto ?? {};
const textoCompartir = `${ev.titulo} · ${fechaCorta(ev.fecha)} · ${ev.lugar.nombre}`;
---

<Base titulo={ev.titulo} descripcion={`${nombreTipo(ev.tipo)} · ${fechaLarga(ev.fecha)} · ${ev.lugar.nombre}, ${ev.lugar.ciudad}`}>
  <article class="ficha contenedor" data-acento={acento}>
    <a href="/" class="volver">← Todos los eventos</a>

    <header class="ficha__cabecera">
      <p class="ficha__tipo marker">{nombreTipo(ev.tipo)}</p>
      <h1>{ev.titulo}</h1>
      {ev.estado === 'a-confirmar' && <p class="aviso">⚠️ Fecha u horario a confirmar. Chequeá con quien organiza antes de ir.</p>}
      {ev.estado === 'suspendido' && <p class="aviso aviso--off">⛔ Este evento está suspendido.</p>}
      <div class="ficha__tags">
        {ev.disciplinas.map((d) => (
          <span class={`tag tag--${DISCIPLINAS[d].acento}`}>{DISCIPLINAS[d].emoji} {DISCIPLINAS[d].nombre}</span>
        ))}
        {ev.etiquetas.map((t) => <span class="tag">#{t}</span>)}
      </div>
    </header>

    {ev.imagen && <img class="ficha__imagen" src={ev.imagen} alt={`Flyer de ${ev.titulo}`} loading="lazy" />}

    <section class="bloque">
      <h2 class="sr-only">Info importante</h2>
      <dl class="info">
        <div>
          <dt>📅 Cuándo</dt>
          <dd>
            {ev.repite ? (
              <>
                <strong>{etiquetaFrecuencia(ev.repite.frecuencia, ev.fecha)}</strong>
                {ev.repite.hasta && <span class="suave"> · hasta el {fechaCorta(ev.repite.hasta)}</span>}
              </>
            ) : (
              <strong class="primera-mayus">{fechaLarga(ev.fecha)}</strong>
            )}
            {duracion > 0 && ev.fechaFin && <span class="suave"> al {fechaLarga(ev.fechaFin)}</span>}
            <br />
            <span>{horario}</span>
          </dd>
        </div>
        <div>
          <dt>📍 Dónde</dt>
          <dd>
            <strong>{ev.lugar.nombre}</strong>
            <br />
            <span class="suave">{[ev.lugar.direccion, ev.lugar.ciudad, ev.lugar.provincia].filter(Boolean).join(', ')}</span>
            <br />
            <a href={urlMapa(ev.lugar)} target="_blank" rel="noopener">Cómo llegar ↗</a>
          </dd>
        </div>
        {ev.organiza && (
          <div>
            <dt>👥 Organiza</dt>
            <dd>
              <strong>{ev.organiza.nombre}</strong>
              {ev.organiza.instagram && (
                <>
                  <br />
                  <a href={urlInstagram(ev.organiza.instagram)} target="_blank" rel="noopener">
                    @{ev.organiza.instagram.replace(/^@/, '')} ↗
                  </a>
                </>
              )}
              {ev.organiza.web && (
                <>
                  <br />
                  <a href={ev.organiza.web} target="_blank" rel="noopener">Web ↗</a>
                </>
              )}
            </dd>
          </div>
        )}
        <div>
          <dt>🎚️ Nivel</dt>
          <dd>{ev.nivel.map((n) => NIVELES[n]).join(' · ')}</dd>
        </div>
        <div>
          <dt>💸 Costo</dt>
          <dd>{ev.costo}</dd>
        </div>
        {Object.entries(ev.datos).map(([k, v]) => (
          <div>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))}
      </dl>
    </section>

    {proximas.length > 0 && (
      <section class="bloque">
        <h2>Próximas fechas</h2>
        <ul class="proximas">
          {proximas.map((f) => <li data-fecha={f}>{fechaCorta(f)}</li>)}
        </ul>
      </section>
    )}

    <section class="bloque descripcion">
      <h2>De qué se trata</h2>
      <Content />
    </section>

    {(ev.inscripcion || contacto.whatsapp || contacto.instagram || contacto.web) && (
      <section class="bloque">
        <h2>Cómo participar</h2>
        <div class="participar">
          {ev.inscripcion && <a class="btn btn--rosa" href={ev.inscripcion} target="_blank" rel="noopener">Inscribirme ↗</a>}
          {contacto.whatsapp && (
            <a class="btn" href={urlWhatsapp(contacto.whatsapp, `Hola! Vi "${ev.titulo}" en Cultura Freestyle y quería consultar.`)} target="_blank" rel="noopener">
              WhatsApp ↗
            </a>
          )}
          {contacto.instagram && <a class="btn" href={urlInstagram(contacto.instagram)} target="_blank" rel="noopener">Instagram ↗</a>}
          {contacto.web && <a class="btn" href={contacto.web} target="_blank" rel="noopener">Más info ↗</a>}
        </div>
      </section>
    )}
  </article>

  <div class="acciones">
    <div class="contenedor acciones__fila">
      <a class="btn" href={`/eventos/${evento.id}.ics`} download={`${evento.id}.ics`}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16v13H4zM4 11h16M9 4v5M15 4v5" /></svg>
        Agendar
      </a>
      <a class="btn" href={urlMapa(ev.lugar)} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" /></svg>
        Ir
      </a>
      <button class="btn btn--azul" type="button" id="compartir" data-titulo={ev.titulo} data-texto={textoCompartir}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM6 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM18 22a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM8.6 13.5l6.8 4M15.4 6.5l-6.8 4" /></svg>
        Compartir
      </button>
    </div>
  </div>
</Base>

<script>
  import { hoyLocal } from '../../lib/fechas';

  const hoy = hoyLocal();
  document.querySelectorAll<HTMLElement>('.proximas li').forEach((li) => {
    if (li.dataset.fecha! < hoy) li.remove();
  });

  const boton = document.getElementById('compartir') as HTMLButtonElement;
  boton.addEventListener('click', async () => {
    const datos = { title: boton.dataset.titulo, text: boton.dataset.texto, url: location.href };
    if (navigator.share) {
      try {
        await navigator.share(datos);
      } catch {
        /* el usuario canceló */
      }
      return;
    }
    await navigator.clipboard.writeText(`${datos.text}\n${datos.url}`);
    const original = boton.lastChild!.textContent;
    boton.lastChild!.textContent = ' ¡Link copiado!';
    setTimeout(() => (boton.lastChild!.textContent = original), 2000);
  });
</script>

<style>
  .ficha {
    --acento: var(--azul);
    padding-top: 16px;
  }
  .ficha[data-acento='pink'] {
    --acento: var(--rosa);
  }
  .volver {
    display: inline-block;
    color: var(--texto-suave);
    text-decoration: none;
    font-size: 14px;
    padding: 6px 0;
  }
  .ficha__cabecera {
    margin: 14px 0 20px;
  }
  .ficha__tipo {
    color: var(--acento);
    font-size: 20px;
    margin: 0 0 4px;
  }
  h1 {
    font-size: clamp(36px, 11vw, 64px);
    margin-bottom: 14px;
  }
  .ficha__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .aviso {
    padding: 10px 14px;
    border-radius: 10px;
    background: #3a3215;
    color: #ffd76a;
    font-size: 14.5px;
  }
  .aviso--off {
    background: #3a1520;
    color: #ff8a9f;
  }
  .ficha__imagen {
    width: 100%;
    max-width: 520px;
    border-radius: var(--radio);
    border: 2px solid var(--borde);
    margin-bottom: 20px;
  }

  .bloque {
    margin-bottom: 28px;
    max-width: 760px;
  }
  .bloque h2 {
    font-size: 22px;
    padding-bottom: 8px;
    margin-bottom: 12px;
    border-bottom: 2px solid #262626;
  }

  .info {
    margin: 0;
    display: grid;
    gap: 2px;
    background: var(--superficie);
    border: 2px solid #2a2a2a;
    border-radius: var(--radio);
    box-shadow: 4px 4px 0 var(--acento);
    overflow: hidden;
  }
  .info > div {
    display: grid;
    grid-template-columns: 112px 1fr;
    gap: 12px;
    padding: 12px 16px;
    border-bottom: 1px solid #262626;
  }
  .info > div:last-child {
    border-bottom: 0;
  }
  .info dt {
    color: var(--texto-suave);
    font-size: 14px;
    font-weight: 600;
  }
  .info dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .suave {
    color: var(--texto-suave);
  }
  .primera-mayus::first-letter {
    text-transform: uppercase;
  }

  .proximas {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .proximas li {
    padding: 6px 12px;
    border-radius: 999px;
    border: 2px solid var(--acento);
    font-weight: 600;
    font-size: 14px;
  }

  .descripcion :global(p) {
    margin: 0 0 12px;
    color: #dcdcdc;
  }
  .descripcion :global(ul) {
    padding-left: 20px;
    color: #dcdcdc;
  }

  .participar {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .acciones {
    position: sticky;
    bottom: calc(var(--nav-alto) + env(safe-area-inset-bottom));
    z-index: 15;
    background: rgb(17 17 17 / 0.94);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-top: 1px solid #262626;
    padding-block: 10px;
  }
  .acciones__fila {
    display: grid;
    grid-template-columns: 1fr auto 1.3fr;
    gap: 8px;
  }
  .acciones .btn {
    padding-inline: 12px;
  }
  .acciones svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  @media (min-width: 900px) {
    .acciones {
      bottom: 0;
    }
    .acciones__fila {
      max-width: 760px;
      margin-inline: 0;
      margin-left: max(0px, calc((100% - 1100px) / 2));
    }
  }
</style>
